{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bun Tracker",
  "version": "0.4.0",
  "identifier": "io.github.mrbununiverse.buntracker",
  "build": {
    "beforeDevCommand": { "script": "pnpm start", "cwd": "../app", "wait": false },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../app" },
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' data: ws://localhost:21110 ws://127.0.0.1:21110 http://127.0.0.1:6970",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../NOTICE": "licenses/NOTICE",
      "../../LICENSE": "licenses/LICENSE",
      "../../docs/licenses/LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../server/core/resources/ThirdPartyNotices.txt": "licenses/ThirdPartyNotices.txt",
      "../app/public/fonts/OFL-Lexend.txt": "licenses/fonts/OFL-Lexend.txt",
      "../app/public/fonts/OFL-NotoSans.txt": "licenses/fonts/OFL-NotoSans.txt",
      "../app/public/fonts/OFL-OpenDyslexic.txt": "licenses/fonts/OFL-OpenDyslexic.txt",
      "../app/public/fonts/UFL-Ubuntu.txt": "licenses/fonts/UFL-Ubuntu.txt"
    }
  }
}
