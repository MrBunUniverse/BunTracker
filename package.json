{
  "name": "bun-tracker",
  "version": "0.4.0",
  "author": "MrBunUniverse",
  "homepage": "https://github.com/MrBunUniverse/BunTracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBunUniverse/BunTracker.git"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "solarxr-protocol",
    "gui/app",
    "gui/tauri"
  ],
  "scripts": {
    "start": "bash \"Start Bun Tracker.command\"",
    "build": "pnpm --dir gui/tauri build",
    "lint": "pnpm --dir gui/app lint",
    "lint:fix": "pnpm --dir gui/app lint:fix",
    "test": "pnpm --dir gui/app test",
    "verify": "bash tools/verify.sh",
    "check:docs": "python3 tools/check-docs.py",
    "update-solarxr": "cd solarxr-protocol && pnpm run build",
    "prepare": "husky && pnpm run update-solarxr",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  }
}
